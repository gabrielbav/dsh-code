    "test:docker": "DSH_CODE_DOCKER_TESTS=1 vitest run tests/integration"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
