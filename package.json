  "description": "Code mode for DeepSeek Harness: per-session Docker + gVisor workspaces with repository and branch selection",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/gabrielbav/dsh-code.git" },
  "engines": { "node": ">=24.9.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
